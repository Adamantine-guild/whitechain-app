# WhiteChain App Environment Configuration Example
# Copy this file to .env and fill in your values
# Do not commit .env to version control

# Application Configuration
NEXT_PUBLIC_APP_NAME=WhiteChain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=https://api.your.network
NEXT_PUBLIC_RPC_URL=https://rpc.your.network

# Contract Addresses
NEXT_PUBLIC_GRANT_CONTRACT_ADDRESS=0xGrantContract

# Wallet Connection
# Get a project ID at https://cloud.walletconnect.com to enable the WalletConnect option
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Authentication (if applicable)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_FEATURE_X=false

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Environment
NODE_ENV=development
