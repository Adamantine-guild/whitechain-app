# WhiteChain App Environment Configuration Example
# Copy this file to .env and fill in your values
# Do not commit .env to version control

# Application Configuration
NEXT_PUBLIC_APP_NAME=WhiteChain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=https://api.your.network
NEXT_PUBLIC_RPC_URL=https://rpc.your.network

# RPC Failover
# Provide a comma separated list of RPC endpoints per chain to enable
# client side failover and fastest node ranking. When more than one URL is
# given the app fails over automatically if a provider times out or errors.
NEXT_PUBLIC_MAINNET_RPC_URLS=https://primary.mainnet.rpc,https://secondary.mainnet.rpc
NEXT_PUBLIC_SEPOLIA_RPC_URLS=https://primary.sepolia.rpc,https://secondary.sepolia.rpc

# Contract Addresses
NEXT_PUBLIC_GRANT_CONTRACT_ADDRESS=0xGrantContract

# Wallet Connection
# Get a project ID at https://cloud.walletconnect.com to enable the WalletConnect option
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Authentication (if applicable)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_FEATURE_X=false

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Environment
NODE_ENV=development
